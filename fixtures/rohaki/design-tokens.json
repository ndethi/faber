          "900": { "value": "#14532d", "type": "color" },
          "950": { "value": "#052e16", "type": "color" }
        },
        "sage": {
          "50":  { "value": "#f6fef7", "type": "color" },
          "100": { "value": "#e8fce5", "type": "color" },
