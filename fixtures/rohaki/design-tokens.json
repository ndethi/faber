{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faberframework.com/schemas/design-tokens/v1",
  "name": "rohaki-design-tokens",
  "version": "1.0.0",
  "description": "Rohaki ESG Bamboo Supply Chain design tokens - Faber fixture. Green gradients, card grids, stats section for bamboo/sustainability brand.",
  "framework": "faber",
  "fixture": "rohaki",
  "format": "design-tokens",
  "tokens": {
